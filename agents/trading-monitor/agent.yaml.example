name: Trading Monitor
description: Live signal handler. Receives trading signal webhooks (Gold Scalping, Ceddi, etc.), parses them, decides action, logs to hive mind. Read-only on the lab; never sends orders.

telegram_bot_token_env: TRADING_MONITOR_BOT_TOKEN

model: claude-sonnet-4-6

# ────────────────────────────────────────────────────────────────────
# Slice 1 schema (additive). Persona lives in CLAUDE.md.
# ────────────────────────────────────────────────────────────────────

four_rs:
  results:
    - "Triggered task acknowledged within 60s of webhook receipt"
    - "Signal logged to hive_mind with provider, side, instrument, levels"
    - "Notify Joe via Telegram on any signal flagged high-priority"

owns:
  scheduled_tasks: []
  triggered_tasks:
    - trading-monitor-trigger
  n8n_workflows: []
  watchers:
    - trading-monitor-trigger

lob: "trading"

projects:
  - "live-signal-routing"

ideal: false

platform: "claude"

skills:
  primary:
    - "lab-query-signal-performance"
    - "lab-query-channel-credibility"

avatar: ""

# ────────────────────────────────────────────────────────────────────
# Slice 10 Wave 0 — Org Chart V2 (added by scripts/migrate-org-v2.ts).
# Additive only. Drives the new /api/org-chart-v2 endpoint and the
# OrgChartV2 page. The Slice 3 /api/org-chart/* endpoints ignore these.
# ────────────────────────────────────────────────────────────────────

# Slice 10: node type for the org chart — "ai" or "human".
# Every agent.yaml is "ai"; humans live in humans.yaml.
type: "ai"

# Slice 10: id of the parent node on the org chart. Empty string (or
# omitted) means "root" — only Joe should ever be root. AI nodes may
# occupy any tier, so this can point at another AI (e.g. "meta") or a
# human id from humans.yaml.
reports_to: "joe"
